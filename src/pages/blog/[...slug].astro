---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const iso = post.data.date.toISOString().slice(0, 10);
const words = (post.body ?? '').split(/\s+/).length;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: iso,
  author: { '@type': 'Person', name: 'Josef Tot', url: 'https://www.joseftot.com/about/' },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---
<Base title={post.data.title} description={post.data.description} cmd={`cat ${post.id}.md`} jsonld={jsonld} article>
  <article>
    <header class="post-head">
      <h1>{post.data.title}</h1>
      <p class="post-meta">
        <time datetime={iso}>{iso}</time>
        <span>{Math.max(1, Math.round(words / 220))} min read</span>
        <span>{post.data.tags.map((t) => `#${t}`).join(' ')}</span>
      </p>
    </header>
    <div class="prose"><Content /></div>
  </article>
  <a class="backlink" href="/blog/">&lt;- cd ..</a>
</Base>
