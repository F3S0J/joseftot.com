---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const iso = (d: Date) => d.toISOString().slice(0, 10);
---
<Base title="Blog" description="Thoughts, methods and field notes by Josef Tot." cmd="ls -lt">
  <h1>Blog</h1>
  <p class="lede dim">Thoughts, methods, field notes. Newest first. Also available as <a href="/rss.xml">RSS</a>.</p>
  <ul class="log" style="margin-top:2rem">
    {posts.map((p) => (
      <li>
        <a href={`/blog/${p.id}/`}>
          <time datetime={iso(p.data.date)}>{iso(p.data.date)}</time>
          <span class="t">{p.data.title}</span>
          <span class="tags">{p.data.tags.map((t) => `#${t}`).join(' ')}</span>
          <span class="d">{p.data.description}</span>
        </a>
      </li>
    ))}
  </ul>
</Base>
