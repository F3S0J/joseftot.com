---
import Base from '../layouts/Base.astro';
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Josef Tot',
  url: 'https://www.joseftot.com/',
  email: 'mailto:info@joseftot.com',
  jobTitle: 'IT professional and developer',
